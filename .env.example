# ============================================================
# Emergency Ambulance Dispatch System - Environment Variables
# ============================================================
# Copy this file to .env and fill in real values.
# Never commit .env to version control.

# ---- Database ----
DATABASE_URL="postgresql://dispatch_user:dispatch_pass@localhost:5432/emergency_dispatch?schema=public"
DB_USER=dispatch_user
DB_PASSWORD=dispatch_pass
DB_NAME=emergency_dispatch

# ---- JWT ----
JWT_SECRET=API_HERE
JWT_EXPIRES_IN=7d

# ---- Backend Server ----
PORT=4000
NODE_ENV=development

# ---- Google Maps / Routes / Geocoding (server-side, optional) ----
# Only needed if you prefer Google Routes API over the default OSRM routing.
GOOGLE_MAPS_API_KEY=API_HERE

# ---- Routing Mode ----
# OSRM is used by default — free, no key, real OpenStreetMap roads.
# Set MOCK_ROUTING=true only to force straight-line (offline testing).
MOCK_ROUTING=false

# ---- OSRM ----
# Public demo server — fine for development/demos. Use your own for production.
OSRM_BASE_URL=https://router.project-osrm.org
DISABLE_OSRM=false

# ---- CORS ----
FRONTEND_URL=http://localhost:5173

# ---- Simulation ----
SIMULATION_TICK_MS=3000
SIMULATION_SPEED_MULTIPLIER=1
